{
  "name": "frc-attendance-tracker",
  "version": "1.0.0",
  "description": "FRC Robotics Team Attendance Tracker PWA",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
